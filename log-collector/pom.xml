<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
             https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- ─── Project coordinates ─────────────────────────────────────────── -->
    <groupId>com.devops</groupId>
    <artifactId>log-collector</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>
    <name>log-collector</name>
    <description>E-commerce event log collector – Spring Boot REST API</description>

    <!-- ─── Spring Boot parent (dependency management) ──────────────────── -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.5</version>
        <relativePath/>
    </parent>

    <!-- ─── Properties ──────────────────────────────────────────────────── -->
    <properties>
        <java.version>17</java.version>
        <docker.image.name>log-collector</docker.image.name>
        <docker.image.tag>latest</docker.image.tag>
        <!-- dockerfile-maven-plugin -->
        <dockerfile-maven-plugin.version>1.4.13</dockerfile-maven-plugin.version>
        <!-- Hadoop client -->
        <hadoop.version>3.3.6</hadoop.version>
        <!--
            Pin byte-buddy to the version resolved by dependency:go-offline so that
            mvn package (which runs without network access inside the Docker build layer)
            does not attempt to fetch a newer transitive version pulled in by Mockito.
        -->
        <byte-buddy.version>1.14.9</byte-buddy.version>
    </properties>

    <!-- ─── Dependencies ────────────────────────────────────────────────── -->
    <dependencies>

        <!-- Spring Web (REST API) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Spring Boot Actuator – exposes /actuator/health for Docker healthcheck -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Bean Validation (Jakarta) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Jackson (JSON) – brought in transitively, listed explicitly for clarity -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!-- ── Hadoop HDFS client ──────────────────────────────────────────── -->
        <!--
             hadoop-client-api  : public FileSystem / Configuration API
             hadoop-client-runtime: shaded runtime (avoids Guava / Protobuf clashes)
             We exclude log4j pulled in transitively to keep SLF4J as the only
             logging façade, matching the rest of the Spring Boot stack.
        -->
        <dependency>
            <groupId>org.apache.hadoop</groupId>
            <artifactId>hadoop-client-api</artifactId>
            <version>${hadoop.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.hadoop</groupId>
            <artifactId>hadoop-client-runtime</artifactId>
            <version>${hadoop.version}</version>
            <exclusions>
                <!-- Hadoop bundles log4j 1.x; SLF4J is already on the classpath -->
                <exclusion>
                    <groupId>log4j</groupId>
                    <artifactId>log4j</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.slf4j</groupId>
                    <artifactId>slf4j-log4j12</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.slf4j</groupId>
                    <artifactId>slf4j-reload4j</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <!-- ─── Build ───────────────────────────────────────────────────────── -->
    <build>


        <finalName>${project.artifactId}</finalName>

        <plugins>

            <!-- ── 1. Spring Boot Maven Plugin (executable fat JAR) ──────── -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>repackage</id>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- ── 3. dockerfile-maven-plugin  →  Docker image ────────── -->
            <plugin>
                <groupId>com.spotify</groupId>
                <artifactId>dockerfile-maven-plugin</artifactId>
                <version>${dockerfile-maven-plugin.version}</version>
                <executions>
                    <execution>
                        <id>build-docker-image</id>
                        <phase>install</phase>
                        <goals>
                            <goal>build</goal>
                            <goal>tag</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <dockerfile>${project.basedir}/Dockerfile</dockerfile>
                    <repository>${docker.image.name}</repository>
                    <tag>${docker.image.tag}</tag>
                    <buildArgs>
                        <JAR_FILE>target/${project.build.finalName}.jar</JAR_FILE>
                    </buildArgs>
                </configuration>
            </plugin>

        </plugins>
    </build>

    <!-- ─── Plugin repository for Spotify dockerfile-maven-plugin ───────── -->
    <pluginRepositories>
        <pluginRepository>
            <id>central</id>
            <url>https://repo.maven.apache.org/maven2</url>
            <releases><enabled>true</enabled></releases>
            <snapshots><enabled>false</enabled></snapshots>
        </pluginRepository>
    </pluginRepositories>

</project>
