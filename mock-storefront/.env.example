# ── mock-storefront environment variables ──────────────────────────────────


# URL of the log-collector service
LOG_COLLECTOR_URL=http://log-collector:8080/api/logs

# How often (seconds) to emit a new event
EMIT_INTERVAL_SECONDS=2

# HTTP request timeout (seconds)
HTTP_TIMEOUT_SECONDS=5

# Number of retry attempts on failure
HTTP_RETRY_ATTEMPTS=3
